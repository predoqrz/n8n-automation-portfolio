# Banco de dados
POSTGRES_USER=n8n
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=n8n

# Acesso ao n8n
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/

# Chave de criptografia das credenciais.
# Gere com: openssl rand -base64 32
# Se você perder esta chave, todas as credenciais salvas no n8n ficam ilegíveis.
N8N_ENCRYPTION_KEY=

# Provedor de LLM (usado nos workflows 01 e 03)
OPENAI_API_KEY=

# --- Workflow 01: triagem de chamados ---
# Label do Gmail aplicada no e-mail depois de processado.
# Pegue o ID (formato Label_1234567890) em: Gmail > Configurações > Labels,
# ou rode o nó Gmail com a operação "Get Many Labels" uma vez.
GMAIL_LABEL_PROCESSADO=

# IDs das listas do Trello, uma por categoria.
# Para descobrir: abra o board e acrescente .json na URL, ou use
# https://trello.com/b/SEU_BOARD.json e procure por "lists".
TRELLO_LIST_ACESSO=
TRELLO_LIST_REDE=
TRELLO_LIST_EQUIPAMENTO=
TRELLO_LIST_SISTEMAS=
TRELLO_LIST_REVISAO=
