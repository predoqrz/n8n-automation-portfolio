# Banco de dados
POSTGRES_USER=n8n
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=n8n

# Acesso ao n8n
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/

# Chave de criptografia das credenciais.
# Gere com: openssl rand -base64 32
# Se você perder esta chave, todas as credenciais salvas no n8n ficam ilegíveis.
N8N_ENCRYPTION_KEY=

# Provedor de LLM (usado nos workflows 01 e 03)
OPENAI_API_KEY=

# --- Workflow 01: triagem de chamados ---
# Usados SÓ pelo script workflows/01-triagem-chamados/scripts/notion-database.mjs.
# O n8n não lê estas variáveis: no n8n 2 o acesso a $env nos nós é bloqueado por
# padrão, então o token fica na credencial e os IDs ficam escolhidos no próprio nó.
# Token da conexão: Notion > Developer tools > Connections
NOTION_TOKEN=
# Página onde o database será criado. Pode colar a URL inteira.
NOTION_PARENT_PAGE_ID=
# Preenchido com o ID que o script imprime; usado pelo --conferir.
NOTION_DATABASE_CHAMADOS=

# --- Workflow 05: atendimento humanizado no WhatsApp + CRM ---
# Chave que protege a API da Evolution (gateway WhatsApp não-oficial, self-hosted).
# Vai tanto no cabeçalho `apikey` das chamadas quanto na variável do container.
# Gere com: openssl rand -hex 24
EVOLUTION_API_KEY=
# Segredo que a Evolution manda no cabeçalho x-webhook-secret de toda chamada ao n8n.
# Sem ele, o webhook do workflow responde 403. Gere com: openssl rand -hex 24
EVOLUTION_WEBHOOK_SECRET=

# Token de API do Monday.com. Usado pelo script scripts/monday-board.mjs para
# criar o board, e depois colado na credencial "Monday.com API" do n8n.
# Gere em: avatar > Administração > API ou developer.monday.com/api-reference
MONDAY_API_TOKEN=
# Preenchido com o ID que o script imprime; usado pelo --conferir e pelos nós do
# workflow que leem/gravam no board.
MONDAY_BOARD_ID=

# --- Workflow 07: ponte n8n <-> UiPath Orchestrator ---
# External Application criada em Automation Cloud > Admin > External Applications,
# tipo Confidential, com Application scopes: OR.Execution, OR.Jobs, OR.Folders.Read.
# Usados pelo script workflows/07-ponte-n8n-uipath/scripts/orchestrator_api.py.
# Organização e tenant: os nomes que aparecem em cloud.uipath.com/<org>/<tenant>/
UIPATH_ORG=
UIPATH_TENANT=DefaultTenant
UIPATH_CLIENT_ID=
UIPATH_CLIENT_SECRET=
# ID numérico da pasta do Orchestrator onde o processo está publicado (ver --pastas)
UIPATH_FOLDER_ID=
