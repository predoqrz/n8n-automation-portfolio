# Banco de dados
POSTGRES_USER=n8n
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=n8n

# Acesso ao n8n
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/

# Chave de criptografia das credenciais.
# Gere com: openssl rand -base64 32
# Se você perder esta chave, todas as credenciais salvas no n8n ficam ilegíveis.
N8N_ENCRYPTION_KEY=

# Provedor de LLM (usado nos workflows 01 e 03)
OPENAI_API_KEY=
