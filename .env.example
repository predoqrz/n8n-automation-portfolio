# Banco de dados
POSTGRES_USER=n8n
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=n8n

# Acesso ao n8n
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/

# Chave de criptografia das credenciais.
# Gere com: openssl rand -base64 32
# Se você perder esta chave, todas as credenciais salvas no n8n ficam ilegíveis.
N8N_ENCRYPTION_KEY=

# Provedor de LLM (usado nos workflows 01 e 03)
OPENAI_API_KEY=

# --- Workflow 01: triagem de chamados ---
# Label do Gmail aplicada no e-mail depois de processado.
# Pegue o ID (formato Label_1234567890) em: Gmail > Configurações > Labels,
# ou rode o nó Gmail com a operação "Get Many Labels" uma vez.
GMAIL_LABEL_PROCESSADO=

# Database do Notion onde os chamados viram páginas.
# O ID são os 32 caracteres da URL do database:
# notion.so/workspace/<ESTE_PEDACO>?v=...
# Lembre de convidar a integração no database (menu ... > Connections).
NOTION_DATABASE_CHAMADOS=
