              "type": "string",
              "value": "={{ $json.urgencia || 'Baixa' }}"
            },
            {
              "id": "f28",
              "name": "resumo",
              "type": "string",
              "value": "={{ $json.resumo || $('Normalizar campos do chamado').item.json.assunto }}"
            },
            {
              "id": "f29",
              "name": "confianca",
              "type": "number",
              "value": "={{ Number($json.confianca ?? 0) }}"
            },
            {
              "id": "f30",
              "name": "destino",
              "type": "string",
              "value": "revisao-manual"
            },
            {
              "id": "f32",
              "name": "motivo",
              "type": "string",
              "value": "={{ $json.error ? 'Falha na classificação: ' + ($json.error.message || $json.error) : 'Confiança ' + Number($json.confianca ?? 0).toFixed(2) + ' abaixo do limite de 0,70.' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000012",
      "name": "Encaminhar para revisão manual",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        420,
