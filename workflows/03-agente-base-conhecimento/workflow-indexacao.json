    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Um recibo por documento indexado, com quantos trechos ele virou.\nINSERT INTO portfolio.kb_documentos (arquivo, titulo, hash, trechos, indexado_em)\nSELECT x.arquivo, x.titulo, x.hash,\n       (SELECT count(*) FROM kb_chunks WHERE metadata ->> 'fonte' = x.arquivo),\n       now()\n  FROM jsonb_to_recordset($1::jsonb) AS x(arquivo text, titulo text, hash text)\nON CONFLICT (arquivo) DO UPDATE\n   SET titulo = EXCLUDED.titulo, hash = EXCLUDED.hash,\n       trechos = EXCLUDED.trechos, indexado_em = EXCLUDED.indexado_em\nRETURNING arquivo, trechos;",
        "options": {
          "queryReplacement": "={{ [ JSON.stringify($('Separar o que mudou').all().map(i => ({ arquivo: i.json.arquivo, titulo: i.json.titulo, hash: i.json.hash }))) ] }}"
        }
      },
