        "options": {}
      },
      "id": "b3a00000-0000-4000-8000-000000000004",
      "name": "Extrair texto",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Junta cada texto extraído com o nome do arquivo de onde veio.\n// O \"Extrair texto\" devolve um item por arquivo, na mesma ordem do \"Ler documentos\".\nconst arquivos = $('Ler documentos').all();\nreturn $input.all().map((item, i) => {\n  const nome = arquivos[i].binary.data.fileName;\n  const texto = item.json.data || '';\n  // Título = primeira linha \"# ...\" do Markdown; sem ela, o nome do arquivo.\n  const titulo = (texto.match(/^#\\s+(.+)$/m) || [])[1] || nome;\n  return { json: { arquivo: nome, titulo: titulo.trim(), texto } };\n});"
      },
      "id": "b3a00000-0000-4000-8000-000000000005",
      "name": "Preparar documentos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Compara o que está na pasta com o que já foi indexado, pelo hash do conteúdo,\n-- e já apaga os trechos de documentos alterados ou removidos. Se a gravação dos\n-- trechos novos falhar depois, o recibo antigo continua com o hash antigo — e a\n-- próxima execução vê o documento como \"alterado\" de novo. Ela se corrige sozinha.\nWITH atual AS (\n    SELECT * FROM jsonb_to_recordset($1::jsonb) AS x(arquivo text, titulo text, texto text)\n), situacao AS (\n    SELECT a.arquivo, a.titulo, md5(a.texto) AS hash,\n           CASE WHEN d.arquivo IS NULL       THEN 'novo'\n                WHEN d.hash <> md5(a.texto)  THEN 'alterado'\n                ELSE 'igual' END AS situacao\n      FROM atual a\n      LEFT JOIN portfolio.kb_documentos d USING (arquivo)\n    UNION ALL\n    SELECT d.arquivo, d.titulo, d.hash, 'removido'\n      FROM portfolio.kb_documentos d\n     WHERE d.arquivo NOT IN (SELECT arquivo FROM atual)\n), trechos_apagados AS (\n    DELETE FROM kb_chunks\n     WHERE metadata ->> 'fonte' IN (SELECT arquivo FROM situacao WHERE situacao IN ('alterado', 'removido'))\n    RETURNING 1\n), recibos_apagados AS (\n    DELETE FROM portfolio.kb_documentos\n     WHERE arquivo IN (SELECT arquivo FROM situacao WHERE situacao = 'removido')\n    RETURNING 1\n)\nSELECT arquivo, titulo, hash, situacao,\n       (SELECT count(*) FROM trechos_apagados) AS trechos_apagados\n  FROM situacao\n ORDER BY arquivo;",
        "options": {
          "queryReplacement": "={{ [ JSON.stringify($input.all().map(i => ({ arquivo: i.json.arquivo, titulo: i.json.titulo, texto: i.json.texto }))) ] }}"
        }
      },
      "id": "b3a00000-0000-4000-8000-000000000006",
      "name": "Comparar com o índice",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        880,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Postgres account"
        }
      },
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// O banco já disse a situação de cada documento (novo, alterado, igual, removido).\n// Só \"novo\" e \"alterado\" seguem para gerar embeddings — é isso que torna a indexação\n// idempotente e barata: rodar de novo sem mudar nada não chama a OpenAI.\nconst situacao = Object.fromEntries($input.all().map((i) => [i.json.arquivo, i.json]));\nconst docs = $('Preparar documentos').all().map((i) => i.json);\nconst mudou = docs\n  .filter((d) => ['novo', 'alterado'].includes(situacao[d.arquivo]?.situacao))\n  .map((d) => ({ json: { ...d, hash: situacao[d.arquivo].hash, situacao: situacao[d.arquivo].situacao } }));\n\nconst contagem = {};\nfor (const s of Object.values(situacao)) contagem[s.situacao] = (contagem[s.situacao] || 0) + 1;\n\nif (mudou.length === 0) return [{ json: { indexar: false, contagem } }];\nreturn mudou.map((m) => ({ json: { ...m.json, indexar: true, contagem } }));"
      },
      "id": "b3a00000-0000-4000-8000-000000000007",
      "name": "Separar o que mudou",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ]
    },
