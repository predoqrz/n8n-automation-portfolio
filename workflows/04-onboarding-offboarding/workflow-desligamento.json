{
  "name": "04c · Desligamento (sub-workflow)",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "b4c00000-0000-4000-8000-000000000001",
      "name": "Recebe a solicitação aprovada",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE portfolio.rh_solicitacoes SET status = 'em_execucao', atualizada_em = now() WHERE id = $1 RETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $('Recebe a solicitação aprovada').first().json.solicitacao_id ] }}"
        }
      },
      "id": "b4c00000-0000-4000-8000-000000000002",
      "name": "Marcar em execução",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        220,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Sempre uma linha. Na retomada, o que já foi revogado não aparece mais aqui.\nSELECT coalesce(json_agg(sistema ORDER BY sistema), '[]'::json) AS sistemas\n  FROM portfolio.dir_acessos WHERE login = $1 AND revogado_em IS NULL;",
        "options": {
          "queryReplacement": "={{ [ $('Recebe a solicitação aprovada').first().json.login ] }}"
        }
      },
      "id": "b4c00000-0000-4000-8000-000000000003",
      "name": "Listar acessos ativos",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        440,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Um item por acesso ativo. Sem nenhum acesso ativo (ex.: retomada depois de revogar\n// tudo), um item vazio segue mesmo assim, para o fluxo chegar até arquivar a conta.\nconst sistemas = $input.first().json.sistemas || [];\nreturn sistemas.length ? sistemas.map((sistema) => ({ json: { sistema } })) : [{ json: { sistema: null } }];"
      },
      "id": "b4c00000-0000-4000-8000-000000000004",
      "name": "Preparar revogações",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "b4c00000-0000-4000-8000-000000000005",
      "name": "Um sistema por vez",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT CASE WHEN $2::text IS NULL THEN 'nenhum acesso ativo'\n            ELSE portfolio.rh_registrar_etapa($1, 'revogar:' || $2, 'concluida', portfolio.dir_revogar_acesso($3, $2))\n       END AS resultado;",
        "options": {
          "queryReplacement": "={{ [ $('Recebe a solicitação aprovada').first().json.solicitacao_id, $json.sistema, $('Recebe a solicitação aprovada').first().json.login ] }}"
        }
      },
      "id": "b4c00000-0000-4000-8000-000000000006",
      "name": "Revogar acesso",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1100,
        420
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Postgres account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Desligamento NÃO tem rollback: re-conceder acesso a quem está saindo seria o pior\n-- resultado. Ele para, avisa e é retomado depois (o que já foi revogado fica revogado).\nUPDATE portfolio.rh_solicitacoes\n   SET status = 'interrompida', erro = $2, atualizada_em = now()\n WHERE id = $1\nRETURNING id, $3::text AS sistema;",
        "options": {
          "queryReplacement": "={{ [ $('Recebe a solicitação aprovada').first().json.solicitacao_id, 'falha ao revogar ' + $('Um sistema por vez').item.json.sistema + ': ' + ($json.message || 'erro'), $('Um sistema por vez').item.json.sistema ] }}"
        }
      },
      "id": "b4c00000-0000-4000-8000-000000000007",
      "name": "Marcar interrompido",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1340,
        600
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "authentication": "webhook",
        "operation": "sendLegacy",
        "content": "={{ '🚨 **Desligamento de ' + $('Recebe a solicitação aprovada').first().json.nome + ' INCOMPLETO.** Falha ao revogar ' + $json.sistema + '. Acessos ainda ativos são risco de segurança: resolva e envie o formulário de novo para retomar (sem nova aprovação).' }}",
        "options": {
          "username": "RH · Onboarding e Offboarding"
        }
      },
      "id": "b4c00000-0000-4000-8000-000000000008",
      "name": "Alertar desligamento incompleto",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        1560,
        600
      ],
      "credentials": {
        "discordWebhookApi": {
          "id": "",
          "name": "Discord Webhook account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Simulado: num ambiente real, transferiria o OneDrive/Drive do colaborador para o gestor.\nSELECT CASE WHEN portfolio.rh_etapa_feita($1, 'transferir_arquivos') THEN 'pulada (já concluída)'\n            ELSE portfolio.rh_registrar_etapa($1, 'transferir_arquivos', 'concluida', 'arquivos transferidos para ' || $2)\n       END AS resultado;",
        "options": {
          "queryReplacement": "={{ [ $('Recebe a solicitação aprovada').first().json.solicitacao_id, $('Recebe a solicitação aprovada').first().json.gestor ] }}"
        }
      },
      "id": "b4c00000-0000-4000-8000-000000000009",
      "name": "Transferir arquivos",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1100,
        180
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Postgres account"
        }
      },
      "executeOnce": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT CASE WHEN portfolio.rh_etapa_feita($1, 'arquivar_conta') THEN 'pulada (já concluída)'\n            ELSE portfolio.rh_registrar_etapa($1, 'arquivar_conta', 'concluida', portfolio.dir_arquivar_conta($2))\n       END AS resultado;",
        "options": {
          "queryReplacement": "={{ [ $('Recebe a solicitação aprovada').first().json.solicitacao_id, $('Recebe a solicitação aprovada').first().json.login ] }}"
        }
      },
      "id": "b4c00000-0000-4000-8000-000000000010",
      "name": "Arquivar conta",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1320,
        180
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE portfolio.rh_solicitacoes SET status = 'concluida', erro = NULL, atualizada_em = now() WHERE id = $1\nRETURNING (SELECT string_agg(substr(etapa, 9), ', ' ORDER BY etapa) FROM portfolio.rh_etapas\n            WHERE solicitacao_id = $1 AND etapa LIKE 'revogar:%') AS revogados;",
        "options": {
          "queryReplacement": "={{ [ $('Recebe a solicitação aprovada').first().json.solicitacao_id ] }}"
        }
      },
      "id": "b4c00000-0000-4000-8000-000000000011",
      "name": "Concluir desligamento",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1540,
        180
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "authentication": "webhook",
        "operation": "sendLegacy",
        "content": "={{ '🔒 **Desligamento de ' + $('Recebe a solicitação aprovada').first().json.nome + ' concluído.** Acessos revogados: ' + ($json.revogados || 'nenhum ativo') + ' · Arquivos transferidos para ' + $('Recebe a solicitação aprovada').first().json.gestor + ' · Conta arquivada.' }}",
        "options": {
          "username": "RH · Onboarding e Offboarding"
        }
      },
      "id": "b4c00000-0000-4000-8000-000000000012",
      "name": "Avisar RH e gestor",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [
        1760,
