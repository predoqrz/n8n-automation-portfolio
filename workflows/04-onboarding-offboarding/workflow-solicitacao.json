      "id": "b4a00000-0000-4000-8000-000000000001",
      "name": "Formulário do RH",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        0,
        300
      ],
      "webhookId": "b4a0f0e1-7c3d-4e2a-9b1f-04a0c0ffee01"
