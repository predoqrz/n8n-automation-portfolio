    {
      "parameters": {
        "jsCode": "// Transforma a resposta do formulário no que o resto do fluxo usa.\n// O login sai do nome: \"Ana Lúcia de Souza\" → \"ana.souza\" (primeiro + último nome, sem acento).\nconst f = $input.first().json;\nconst tipo = f['Tipo'] === 'Desligamento' ? 'desligamento' : 'admissao';\nconst nome = (f['Nome completo'] || '').trim().replace(/\\s+/g, ' ');\nconst partes = nome.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z ]/g, '').split(' ').filter(Boolean);\nconst login = partes.length > 1 ? partes[0] + '.' + partes[partes.length - 1] : (partes[0] || '');\n\nlet erro = null;\nif (partes.length < 2) erro = 'informe nome e sobrenome';\nelse if (tipo === 'admissao' && !f['Perfil']) erro = 'admissão precisa do perfil do cargo';\n\nreturn [{ json: { tipo, nome, login, perfil: f['Perfil'] || null, gestor: (f['Gestor'] || '').trim(), data_efetiva: f['Data efetiva'], erro } }];"
      },
      "id": "b4a00000-0000-4000-8000-000000000002",
      "name": "Normalizar solicitação",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Idempotente: o mesmo formulário enviado de novo cai no ON CONFLICT e devolve a solicitação\n-- que já existe. Uma admissão que falhou e foi revertida volta para 'recebida' (pode tentar de novo).\nINSERT INTO portfolio.rh_solicitacoes (tipo, nome, login, perfil, gestor, data_efetiva)\nVALUES ($1, $2, $3, $4, $5, $6::date)\nON CONFLICT (tipo, login, data_efetiva) DO UPDATE\n   SET status = CASE WHEN rh_solicitacoes.status = 'falhou_revertida' THEN 'recebida' ELSE rh_solicitacoes.status END,\n       atualizada_em = now()\nRETURNING id AS solicitacao_id, status, (xmax = 0) AS nova,\n          coalesce((SELECT status = 'ativa' FROM portfolio.dir_contas WHERE login = $3), false) AS conta_ativa;",
        "options": {
          "queryReplacement": "={{ [ $json.tipo, $json.nome, $json.login, $json.perfil, $json.gestor, $json.data_efetiva ] }}"
        }
      },
      "id": "b4a00000-0000-4000-8000-000000000003",
      "name": "Registrar solicitação",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        440,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Decide o que fazer com a solicitação, a partir do que o banco devolveu.\n// Toda saída tem \"acao\" e \"motivo\": nada é descartado sem explicação.\nconst s = { ...$('Normalizar solicitação').first().json, ...$input.first().json };\nlet acao = 'ignorar';\nlet motivo = null;\n\nif (s.erro) motivo = 'formulário inválido: ' + s.erro;\nelse if (s.tipo === 'admissao') {\n  if (s.nova || s.status === 'recebida') acao = 'admitir';\n  else motivo = 'admissão já registrada (status: ' + s.status + ')';\n} else {\n  if (s.status === 'interrompida') acao = 'retomar_desligamento'; // já aprovado; só continua\n  else if (!(s.nova || s.status === 'recebida')) motivo = 'desligamento já registrado (status: ' + s.status + ')';\n  else if (!s.conta_ativa) motivo = 'não existe conta ativa com o login ' + s.login;\n  else acao = 'pedir_aprovacao';\n}\nreturn [{ json: { ...s, acao, motivo } }];"
      },
