    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- A aprovação fica gravada (quem, quando, por quê) antes de qualquer ação destrutiva.\n-- Sem resposta no prazo do Wait, a decisão vem vazia e conta como recusa.\nUPDATE portfolio.rh_solicitacoes\n   SET status = CASE WHEN $2 = 'Aprovar' THEN 'em_execucao' ELSE 'recusada' END,\n       aprovado_por = nullif($3, ''), decidido_em = now(),\n       motivo = coalesce(nullif($4, ''), CASE WHEN $2 = '' THEN 'sem resposta do gestor em 2 dias' END),\n       atualizada_em = now()\n WHERE id = $1\nRETURNING id AS solicitacao_id, status = 'em_execucao' AS aprovado, aprovado_por, motivo,\n          tipo, nome, login, perfil, gestor, data_efetiva::text AS data_efetiva;",
        "options": {
          "queryReplacement": "={{ [ $('Decidir próximo passo').first().json.solicitacao_id, $json['Decisão'] || '', $json['Seu nome'] || '', $json['Motivo'] || '' ] }}"
        }
      },
